# ==============================================================================
# STREAMLIT BI DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# PostgreSQL (Catalog & Metadata)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalog_db
DB_USER=postgres
DB_PASSWD=your_postgres_password_here

# MongoDB (Metrics, Analytics & Summaries)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=PlatformEventsDB
MONGODB_READER_USER=reader_user
MONGODB_READER_PASSWD=your_mongo_reader_password_here

# Streamlit Server Settings
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
# Optional base path when served behind a reverse proxy (e.g. /bi/)
# STREAMLIT_SERVER_BASE_URL_PATH=bi
