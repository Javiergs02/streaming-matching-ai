# ==============================================================================
# Streaming Matching AI & Data Pipeline - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Catalog & Relational Entities)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalog_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
BK_DB_NAME=canonical_catalog

# ------------------------------------------------------------------------------
# 2. MongoDB Datamart (Event Store & Precomputed Aggregations)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=PlatformEventsDB
MONGODB_READER_USER=reader_user
MONGODB_READER_PASSWD=your_mongo_reader_password_here
MONGODB_WRITER_USER=writer_user
MONGODB_WRITER_PASSWD=your_mongo_writer_password_here
MONGODB_ANALYTICS_COLLECTION=video_performance_events

# ------------------------------------------------------------------------------
# 3. Cloud Storage / Drive (Streaming Reports Synchronizer)
# ------------------------------------------------------------------------------
AMAZON_DRIVE_FOLDER_ID=your_shared_folder_id_here
GDRIVE_CREDS_FILE=infrastructure/credentials/gdrive_credentials.json

# ------------------------------------------------------------------------------
# 4. YouTube Analytics API
# ------------------------------------------------------------------------------
CREDS_FILE=infrastructure/credentials/youtube_credentials.json

# ------------------------------------------------------------------------------
# 5. System Identification & Event Collections
# ------------------------------------------------------------------------------
CMS_ID=DEMO_CMS
MONGODB_CHANNEL_EVENTS_COLLECTION=channel_events
MONGODB_VIDEO_EVENTS_COLLECTION=video_events
MONGODB_DIFFUSION_EVENTS_COLLECTION=diffusion_events
